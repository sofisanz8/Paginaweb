<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Mundo Patitas | Accesorios, Juguetes y Cuidado para Mascotas</title>

    <!-- FUENTES TERNURA & MASCOTAS (FREDOKA Y QUICKSAND) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Quicksand:wght@500;700&display=swap" rel="stylesheet">

    <!-- ESTILO COMPLETAMENTE NUEVO: DULCE, CÁLIDO Y MODERNO -->
    <style>
        :root {
            --primary: #f97316;          /* Naranja cálido */
            --primary-soft: #ffedd5;     /* Naranja pastel suave */
            --accent: #facc15;           /* Amarillo sol */
            --bg-body: #fafaf9;          /* Crema suave de fondo */
            --bg-card: #ffffff;          /* Blanco puro tarjetas */
            --bg-alt: #f5f5f4;           /* Fondo secundario */
            --text-dark: #44403c;        /* Marrón/Gris chocolate */
            --text-muted: #78716c;       /* Texto suave */
            --border-radius: 24px;
            --shadow-soft: 0 10px 25px -5px rgba(249, 115, 22, 0.08);
            --shadow-hover: 0 20px 35px -5px rgba(249, 115, 22, 0.18);
            --transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Quicksand', sans-serif;
            color: var(--text-dark);
            background-color: var(--bg-body);
            line-height: 1.6;
            font-weight: 500;
        }

        h1, h2, h3, .logo {
            font-family: 'Fredoka', cursive;
        }

        /* ==========================================
           ENCABEZADO / NAVEGACIÓN
        ========================================== */
        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.1rem 8%;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(12px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            border-bottom: 2px solid var(--primary-soft);
        }

        .logo {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo::before {
            content: "🐾";
            font-size: 1.8rem;
        }

        nav {
            display: flex;
            gap: 1.5rem;
        }

        nav a {
            color: var(--text-dark);
            text-decoration: none;
            font-weight: 700;
            font-size: 1rem;
            transition: var(--transition);
            padding: 8px 16px;
            border-radius: 20px;
        }

        nav a:hover {
            background-color: var(--primary-soft);
            color: var(--primary);
        }

        /* ==========================================
           HERO (BANNER PRINCIPAL)
        ========================================== */
        .hero {
            position: relative;
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 3rem 5%;
        }

        .hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(68, 64, 60, 0.6) 0%, rgba(68, 64, 60, 0.4) 100%);
            z-index: 1;
            border-bottom-left-radius: 40px;
            border-bottom-right-radius: 40px;
        }

        .hero-text {
            position: relative;
            z-index: 2;
            max-width: 850px;
            color: #ffffff;
        }

        .hero-text h1 {
            font-size: 3.4rem;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 1.2rem;
            text-shadow: 0 3px 12px rgba(0,0,0,0.3);
        }

        .hero-text p {
            font-size: 1.3rem;
            margin-bottom: 2.2rem;
            color: #f5f5f4;
            font-weight: 500;
        }

        .hero-text button {
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 1.1rem 3rem;
            font-size: 1.1rem;
            font-weight: 700;
            font-family: 'Fredoka', cursive;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(249, 115, 22, 0.4);
            transition: var(--transition);
        }

        .hero-text button:hover {
            background: #ea580c;
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 15px 30px rgba(249, 115, 22, 0.5);
        }

        /* ==========================================
           SECCIONES GENERALES
        ========================================== */
        .section {
            padding: 5rem 8%;
        }

        .section.fondo {
            background-color: var(--bg-alt);
        }

        .section h2 {
            text-align: center;
            font-size: 2.5rem;
            color: var(--text-dark);
            margin-bottom: 2.5rem;
            position: relative;
        }

        .section h2::after {
            content: '🦴';
            display: block;
            font-size: 1.2rem;
            margin-top: 5px;
        }

        .texto-centro {
            text-align: center;
            max-width: 750px;
            margin: 0 auto;
            font-size: 1.2rem;
            color: var(--text-muted);
        }

        /* ==========================================
           TARJETAS DE SERVICIOS
        ========================================== */
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2.2rem;
        }

        .card {
            background: var(--bg-card);
            padding: 2.5rem 2rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-soft);
            transition: var(--transition);
            border: 2px solid #f5f5f4;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: var(--shadow-hover);
            border-color: var(--primary-soft);
        }

        .card h3 {
            font-size: 1.5rem;
            color: var(--primary);
            margin-bottom: 1rem;
        }

        .card p {
            color: var(--text-muted);
            font-size: 1rem;
            margin-bottom: 1.8rem;
        }

        .card button {
            background-color: var(--primary-soft);
            color: var(--primary);
            border: none;
            padding: 0.8rem 1.8rem;
            border-radius: 30px;
            font-weight: 700;
            font-family: 'Fredoka', cursive;
            cursor: pointer;
            transition: var(--transition);
            align-self: flex-start;
        }

        .card button:hover {
            background-color: var(--primary);
            color: #ffffff;
        }

        /* ==========================================
           GALERÍA DE IMÁGENES
        ========================================== */
        .galeria {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .galeria img {
            width: 100%;
            height: 260px;
            object-fit: cover;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-soft);
            cursor: pointer;
            transition: var(--transition);
            border: 4px solid #ffffff;
        }

        .galeria img:hover {
            transform: scale(1.05) rotate(1deg);
            box-shadow: var(--shadow-hover);
        }

        /* ==========================================
           CALCULADORA
        ========================================== */
        .calculadora {
            max-width: 440px;
            margin: 0 auto;
            background: var(--bg-card);
            padding: 2.5rem;
            border-radius: var(--border-radius);
            box-shadow: var(--shadow-soft);
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
            border: 3px solid var(--primary-soft);
        }

        .calculadora input {
            width: 100%;
            padding: 1rem 1.2rem;
            background: var(--bg-body);
            border: 2px solid #e7e5e4;
            border-radius: 16px;
            font-size: 1.1rem;
            color: var(--text-dark);
            font-family: 'Fredoka', cursive;
            outline: none;
            transition: var(--transition);
        }

        .calculadora input:focus {
            border-color: var(--primary);
            background: #ffffff;
        }

        .botones-calculadora {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0.8rem;
        }

        .botones-calculadora button {
            background: var(--primary-soft);
            color: var(--primary);
            border: none;
            padding: 1rem;
            font-size: 1.4rem;
            font-weight: 700;
            font-family: 'Fredoka', cursive;
            border-radius: 16px;
            cursor: pointer;
            transition: var(--transition);
        }

        .botones-calculadora button:hover {
            background: var(--primary);
            color: #ffffff;
            transform: translateY(-3px);
        }

        #resultado {
            text-align: center;
            font-size: 1.4rem;
            color: var(--primary);
            margin-top: 0.5rem;
            padding: 1rem;
            background-color: var(--primary-soft);
            border-radius: 16px;
        }

        /* ==========================================
           FORMULARIO DE CONTACTO
        ========================================== */
        form {
            max-width: 580px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 1.2rem;
        }

        form input,
        form textarea {
            width: 100%;
            padding: 1.1rem 1.4rem;
            border: 2px solid #e7e5e4;
            border-radius: 18px;
            font-size: 1rem;
            font-family: inherit;
            transition: var(--transition);
            outline: none;
            background-color: #ffffff;
        }

        form input:focus,
        form textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.12);
        }

        form textarea {
            height: 140px;
            resize: vertical;
        }

        form button[type="submit"] {
            background: var(--primary);
            color: #ffffff;
            border: none;
            padding: 1.1rem;
            font-size: 1.1rem;
            font-weight: 700;
            font-family: 'Fredoka', cursive;
            border-radius: 50px;
            cursor: pointer;
            transition: var(--transition);
            box-shadow: 0 10px 20px rgba(249, 115, 22, 0.25);
        }

        form button[type="submit"]:hover {
            background: #ea580c;
            transform: translateY(-3px);
            box-shadow: 0 15px 25px rgba(249, 115, 22, 0.4);
        }

        /* ==========================================
           PIE DE PÁGINA
        ========================================== */
        footer {
            background-color: var(--text-dark);
            color: #d6d3d1;
            text-align: center;
            padding: 3rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            font-size: 0.95rem;
            border-top-left-radius: 30px;
            border-top-right-radius: 30px;
        }

        /* RESPONSIVE */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                gap: 1rem;
                padding: 1rem 5%;
            }

            nav {
                gap: 0.5rem;
                flex-wrap: wrap;
                justify-content: center;
            }

            .hero-text h1 {
                font-size: 2.3rem;
            }

            .section {
                padding: 3.5rem 5%;
            }
        }
    </style>
</head>

<body>

    <!-- ENCABEZADO -->
    <header>
        <div class="logo">
            Mundo Patitas
        </div>

        <nav>
            <a href="#inicio">Inicio</a>
            <a href="#nosotros">Nosotros</a>
            <a href="#servicios">Servicios</a>
            <a href="#galeria">Galería</a>
            <a href="#contacto">Contacto</a>
        </nav>
    </header>

    <!-- HERO PRINCIPAL -->
    <section id="inicio" class="hero" style="background-image: url('https://oercommons.s3.amazonaws.com/media/courseware/lesson/image/Pets_LDDMenw.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat;">
        <div class="hero-text">
            <h1>Todo para el Bienestar y Diversión de tu Mascota</h1>
            <p>Encuentra los mejores accesorios, juguetes interactivos y alimentos de alta calidad para consentir a tu mejor amigo.</p>
            <button onclick="mostrarMensaje()">Conocer más</button>
        </div>
    </section>

    <!-- SOBRE NOSOTROS -->
    <section id="nosotros" class="section">
        <h2>Sobre Nosotros</h2>
        <p class="texto-centro">
            En Mundo Patitas somos apasionados por los animales. Nos dedicamos a ofrecer productos seleccionados de la más alta calidad, asesoría personalizada y todo lo que tu perro o gato necesita para mantenerse sano y feliz.
        </p>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" class="section fondo">
        <h2>Servicios y Productos</h2>

        <div class="cards">
            <div class="card">
                <h3>Juguetes e Interacción</h3>
                <p>Variedad de juguetes interactivos, rascadores para gatos y pelotas resistentes para perros.</p>
                <button onclick="mostrarServicio('Juguetes e Interacción')">Ver más</button>
            </div>

            <div class="card">
                <h3>Nutrición y Alimentos</h3>
                <p>Las mejores marcas de alimento balanceado, snacks nutritivos y complementos para todas las edades.</p>
                <button onclick="mostrarServicio('Nutrición y Alimentos')">Ver más</button>
            </div>

            <div class="card">
                <h3>Accesorios y Confort</h3>
                <p>Camas ergonómicas, collares ajustables, correas de paseo y accesorios de transporte seguros.</p>
                <button onclick="mostrarServicio('Accesorios y Confort')">Ver más</button>
            </div>
        </div>
    </section>

    <!-- GALERÍA DE IMÁGENES -->
    <section id="galeria" class="section">
        <h2>Galería de Productos</h2>

        <div class="galeria">
            <img src="https://share.google/bgxtzQZc3hLBe3E4K" alt="Mascotas y Accesorios Mundo Patitas" onclick="ampliarImagen(this)">
            <img src="https://m.media-amazon.com/images/I/719eOVbIxDL._AC_.jpg" alt="Juguetes para Gatos Mundo Patitas" onclick="ampliarImagen(this)">
            <img src="https://tse2.mm.bing.net/th/id/OIP.Jw5w4K7ssnAzTFrzvmHtzwHaEO?r=0&rs=1&pid=ImgDetMain&o=7&rm=3" alt="Perros y Gatos Felices" onclick="ampliarImagen(this)">
        </div>
    </section>

    <!-- CALCULADORA -->
    <section class="section fondo">
        <h2>Calculadora</h2>

        <div class="calculadora">
            <input type="number" id="numero1" placeholder="Número 1">
            <input type="number" id="numero2" placeholder="Número 2">

            <div class="botones-calculadora">
                <button onclick="sumar()">+</button>
                <button onclick="restar()">-</button>
                <button onclick="multiplicar()">×</button>
                <button onclick="dividir()">÷</button>
            </div>

            <h3 id="resultado">Resultado: 0</h3>
        </div>
    </section>

    <!-- CONTACTO -->
    <section id="contacto" class="section">
        <h2>Contacto</h2>

        <form onsubmit="enviarFormulario(event)">
            <input type="text" id="nombre" placeholder="Nombre" required>
            <input type="email" id="correo" placeholder="Correo electrónico" required>
            <textarea id="mensaje" placeholder="Escribe tu mensaje o consulta sobre tus mascotas" required></textarea>
            <button type="submit">Enviar</button>
        </form>
    </section>

    <!-- PIE DE PÁGINA -->
    <footer>
        <p>© 2026 Mundo Patitas - Tienda de Mascotas</p>
        <p>Página creada con HTML, CSS y JavaScript</p>
    </footer>

    <script src="script.js"></script>

</body>
</html>
